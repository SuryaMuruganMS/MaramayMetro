---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/journey.css';
import '../styles/panels.css';
import '../styles/chrome.css';
import '../styles/dig.css';
import '../styles/finds.css';
// After the component sheets: one media treatment that upgrades all of them.
import '../styles/media.css';
// Last on purpose: it undoes the horizontal track and must beat every rule above.
import '../styles/plan-view.css';
// After plan-view, because it corrects geometry that file also touches.
import '../styles/rtl.css';
import Header from '../components/chrome/Header.astro';
import Disclosure from '../components/chrome/Disclosure.astro';
import Foot from '../components/chrome/Foot.astro';
import { translator } from '../i18n/index.ts';
import { BCP47, allHrefs, dirOf, type Locale } from '../lib/locale.ts';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** The locale-neutral path, e.g. '/harita'. Used for the language switch. */
  path: string;
  /** The crossing runs its own chrome; ordinary pages get the standard shell. */
  bare?: boolean;
}

const { locale, title, description, path, bare = false } = Astro.props;
const tt = translator(locale);
const desc = description ?? tt('site.description');
---

<!doctype html>
<html lang={BCP47[locale]} dir={dirOf(locale)} data-band="surface" data-continent="EU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {
      /* Every language declares every other, including itself, plus an
         x-default pointing at English. Search engines need the full set to
         treat the four as one page rather than four competing ones. */
      allHrefs(path).map((a) => (
        <link rel="alternate" hreflang={a.locale} href={new URL(a.href, Astro.site)} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(allHrefs(path)[0]!.href, Astro.site)}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#c4362f" />

    <!--
      Service and view, resolved before the first paint.

      Two things are decided here. First, whether it is day or night service.
      Night is the default, and that is a decision rather than a fallback: the
      tunnel is the subject of this site, the night imagery is the set the
      photography was designed around, and a railway sixty metres under the
      Bosphorus has no daylight in it at any hour. A returning reader's own
      choice always wins over the default.

      (An earlier version read the clock in İstanbul and opened in whichever
      service was actually running. It was a good idea that made the site look
      like a different site depending on when you arrived, which is a poor
      trade for a page most people see exactly once.)

      Plan view used to be decided here too. The escape hatch it drove is still
      in the stylesheet — under 1024px, at 400% zoom and under reduced motion
      the whole site lays out as an ordinary vertical document, which is what
      WCAG 1.4.10 requires — but the button that let a reader ask for it by
      hand has gone. It was a control for a preference nobody has.
    -->
    <script is:inline>
      (function () {
        const r = document.documentElement;
        try {
          r.setAttribute('data-service', localStorage.getItem('marmaray-service') || 'night');
        } catch {
          r.setAttribute('data-service', 'night');
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#main">{tt('nav.skip')}</a>

    <!--
      The concept label. Permanent, in normal flow, above everything.

      Not a dismissible banner and not a corner badge. A fixed corner element
      covers different content at every scroll position - the lesson from
      Kestrel, where exactly that pattern hid copy at sixty combinations before
      a gate caught it. A bar in the flow can never cover anything.
    -->
    <script
      type="application/json"
      id="theme-words"
      set:html={JSON.stringify({
        light: tt('theme.light'),
        dark: tt('theme.dark'),
        toLight: tt('theme.toLight'),
        toDark: tt('theme.toDark'),
      })}
      is:inline
    />

    <Disclosure locale={locale} />
    <Header locale={locale} path={path} />

    <main id="main">
      <slot />
    </main>

    {!bare && <Foot locale={locale} />}

    <script>
      /**
       * Service and view switching.
       *
       * Both write through to localStorage so a choice survives navigation, and
       * both are plain attribute flips - no class juggling, no re-render. The
       * engine watches data-view and reconfigures itself when it changes.
       */
      const root = document.documentElement;

      /** Theme wording, from the page's own dictionary. */
      const THEME = JSON.parse(
        document.getElementById('theme-words')?.textContent || '{}',
      ) as Record<string, string>;

      /**
       * How much fixed chrome sits at the top of the page.
       *
       * The disclosure bar is in normal flow and the header is sticky beneath
       * it, so at rest the header's bottom edge is lower than --head-h. Fixed
       * furniture positioned from --head-h alone lands behind it. Both the
       * crossing readout and the dig axis did exactly that.
       */
      function measureChrome() {
        const head = document.querySelector<HTMLElement>('.head');
        if (!head) return;
        const disclosure = document.querySelector<HTMLElement>('.disclosure');
        const h = (disclosure ? disclosure.offsetHeight : 0) + head.offsetHeight;
        root.style.setProperty('--chrome-h', h + 'px');
      }
      measureChrome();
      window.addEventListener('resize', measureChrome);

      function setService(next: string) {
        /*
           Arm the wipe.

           Every picture holds both modes and CSS decides which is painted. On
           first paint the correct one has to be simply THERE — animating into
           it would flash the wrong picture on every load, which is the exact
           fault the two-in-the-DOM arrangement exists to prevent. So the
           transition is not in the stylesheet until the reader asks for a
           change, and from then on the switch reads like a train passing.
        */
        root.setAttribute('data-svc-anim', '');
        root.setAttribute('data-service', next);
        try {
          localStorage.setItem('marmaray-service', next);
        } catch {
          /* nothing to do; the attribute still applies for this page */
        }
        paintThemeButtons(next);
      }

      /** The button says which theme you are in and what pressing it will do. */
      function paintThemeButtons(mode: string) {
        const dark = mode === 'night';
        document.querySelectorAll<HTMLButtonElement>('[data-service-toggle]').forEach((b) => {
          b.setAttribute('aria-pressed', String(dark));
          b.title = dark ? THEME.toLight : THEME.toDark;
          const label = b.querySelector<HTMLElement>('[data-theme-label]');
          if (label) label.textContent = dark ? THEME.dark : THEME.light;
        });
      }

      paintThemeButtons(root.getAttribute('data-service') ?? 'night');
      document.querySelectorAll<HTMLButtonElement>('[data-service-toggle]').forEach((b) => {
        b.addEventListener('click', () => {
          setService(root.getAttribute('data-service') === 'night' ? 'day' : 'night');
        });
      });

      /**
       * Two-mode video: play exactly the one clip that is worth playing.
       *
       * Every mode video ships as a day file and a night file, both in the DOM
       * so switching service never waits on a download. That leaves three ways
       * to waste a reader's bandwidth and battery, and this closes all three:
       * the hidden mode never plays, a clip off-screen never plays, and under
       * `prefers-reduced-motion` nothing plays at all — the poster stands in,
       * which is a still frame of the same footage rather than a blank box.
       *
       * `preload="none"` in the markup means none of these files is fetched
       * until this decides it is time, so the dig's twelve clips cost nothing
       * to a reader who stops at the third panel.
       */
      const stillOnly = window.matchMedia('(prefers-reduced-motion: reduce)');

      function wantedMode(): string {
        const svc = root.getAttribute('data-service');
        if (svc === 'night' || svc === 'day') return svc;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'day';
      }

      const onScreen = new Set<HTMLVideoElement>();

      function syncVideos() {
        const want = wantedMode();
        document.querySelectorAll<HTMLVideoElement>('[data-mode-video]').forEach((v) => {
          /*
             A clip gated on motion runs only while the train does.

             The film band behind the crossing looped forever, which turned it
             into wallpaper — a train at speed behind a page standing still.
             The engine sets `data-moving` on the document while the reader is
             travelling, and the band follows it. Everything else (the finds
             clips) keeps looping on its own, because nothing there is supposed
             to be tied to a position on a line.
          */
          const gated = v.hasAttribute('data-motion-gated');
          const shouldRun =
            !stillOnly.matches &&
            onScreen.has(v) &&
            v.dataset.modeVideo === want &&
            (!gated || root.hasAttribute('data-moving'));
          if (shouldRun) {
            if (v.preload === 'none') v.preload = 'auto';
            // A rejected play() is normal - a background tab, a power-saving
            // policy - and is not worth reporting to anybody.
            void v.play().catch(() => {});
          } else if (!v.paused) {
            v.pause();
          }
        });
      }

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              const v = e.target as HTMLVideoElement;
              if (e.isIntersecting) onScreen.add(v);
              else onScreen.delete(v);
            }
            syncVideos();
          },
          { rootMargin: '200px' },
        );
        document
          .querySelectorAll<HTMLVideoElement>('[data-mode-video]')
          .forEach((v) => io.observe(v));
      } else {
        document
          .querySelectorAll<HTMLVideoElement>('[data-mode-video]')
          .forEach((v) => onScreen.add(v));
        syncVideos();
      }

      // A change of service changes which of the pair should be running, and
      // the attribute is the single source of that truth for CSS as well.
      new MutationObserver(syncVideos).observe(root, {
        attributes: true,
        attributeFilter: ['data-service', 'data-moving'],
      });
      stillOnly.addEventListener('change', syncVideos);
      document.addEventListener('visibilitychange', syncVideos);
    </script>
  </body>
</html>
