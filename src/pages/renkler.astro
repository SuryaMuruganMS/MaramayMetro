---
import Base from '../layouts/Base.astro';
import Body from '../components/colours/ColoursPage.astro';
import { translator } from '../i18n/index.ts';
import type { Locale } from '../lib/locale.ts';

const locale: Locale = 'en';
const tt = translator(locale);
---

<Base
  locale={locale}
  path="/renkler"
  title={tt('col.title') + ' \u2014 ' + tt('site.full')}
  description={tt('col.lede')}
>
  <Body locale={locale} />
</Base>
