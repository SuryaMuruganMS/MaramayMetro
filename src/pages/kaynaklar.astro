---
import Base from '../layouts/Base.astro';
import Body from '../components/sources/SourcesPage.astro';
import { translator } from '../lib/i18n.ts';
import type { Locale } from '../lib/locale.ts';

const locale: Locale = 'tr';
const tt = translator(locale);
---

<Base
  locale={locale}
  path="/kaynaklar"
  title={tt('src.title') + ' — ' + tt('site.full')}
  description={tt('src.lede')}
>
  <Body locale={locale} />
</Base>
