---
import Base from '../layouts/Base.astro';
import Body from '../components/tunel/TunelPage.astro';
import { translator } from '../lib/i18n.ts';
import type { Locale } from '../lib/locale.ts';

const locale: Locale = 'tr';
const tt = translator(locale);
---

<Base
  locale={locale}
  path="/tunel-1875"
  title={tt('tunel.title') + ' — ' + tt('site.full')}
  description={tt('tunel.lede')}
>
  <Body locale={locale} />
</Base>
