---
import Base from '../../layouts/Base.astro';
import Body from '../../components/fares/FaresPage.astro';
import { translator } from '../../i18n/index.ts';
import type { Locale } from '../../lib/locale.ts';

const locale: Locale = 'tr';
const tt = translator(locale);
---

<Base
  locale={locale}
  path="/ucret"
  title={tt('fare.title') + ' \u2014 ' + tt('site.full')}
  description={tt('fare.lede')}
>
  <Body locale={locale} />
</Base>
