---
import Base from '../../layouts/Base.astro';
import Body from '../../components/build/BuildPage.astro';
import { translator } from '../../i18n/index.ts';
import type { Locale } from '../../lib/locale.ts';

const locale: Locale = 'ru';
const tt = translator(locale);
---

<Base
  locale={locale}
  path="/insaat"
  title={tt('build.title') + ' \u2014 ' + tt('site.full')}
  description={tt('build.lede')}
>
  <Body locale={locale} />
</Base>
