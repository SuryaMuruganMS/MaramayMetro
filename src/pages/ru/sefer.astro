---
import Base from '../../layouts/Base.astro';
import Body from '../../components/plan/PlannerPage.astro';
import { translator } from '../../i18n/index.ts';
import type { Locale } from '../../lib/locale.ts';

const locale: Locale = 'ru';
const tt = translator(locale);
---

<Base
  locale={locale}
  path="/sefer"
  title={tt('plan.title') + ' \u2014 ' + tt('site.full')}
  description={tt('plan.lede')}
>
  <Body locale={locale} />
</Base>
