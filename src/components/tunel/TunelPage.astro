---
import PageHead from '../ui/PageHead.astro';
import Figure from '../ui/Figure.astro';
import Tunel from './Tunel.svelte';
import { translator } from '../../lib/i18n.ts';
import { TUNEL } from '../../data/alignment.ts';
import { num, type Locale } from '../../lib/locale.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tt = translator(locale);

const KEYS = ['tunel.run', 'tunel.stop', 'tunel.reset', 'tunel.karakoy', 'tunel.beyoglu'];
const labels = Object.fromEntries(KEYS.map((k) => [k, tt(k)]));
---

<section class="section">
  <div class="shell stack stack--loose">
    <PageHead
      locale={locale}
      eyebrow={tt('nav.tunel')}
      title={tt('tunel.title')}
      lede={tt('tunel.lede')}
    />

    <dl class="figs">
      <Figure
        locale={locale}
        k={locale === 'tr' ? 'Açılış' : 'Opened'}
        v={String(TUNEL.opened.value)}
        source={TUNEL.opened.source}
      />
      <Figure
        locale={locale}
        k={locale === 'tr' ? 'Uzunluk' : 'Length'}
        v={`${num(TUNEL.lengthM.value, locale)} m`}
        source={TUNEL.lengthM.source}
      />
      <Figure
        locale={locale}
        k={locale === 'tr' ? 'Süre' : 'Journey'}
        v={`${TUNEL.seconds.value} s`}
        source={TUNEL.seconds.source}
      />
    </dl>

    <Tunel client:load locale={locale} labels={labels} />

    <p class="tunel__note mono">{tt('tunel.same')}</p>

    <div class="body">
      <p>{tt('tunel.body')}</p>
    </div>
  </div>
</section>

<style>
  .figs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--sp-base);
    margin: 0;
    padding-top: var(--sp-base);
    border-top: 1px solid var(--rule);
    max-width: 52rem;
  }
  .tunel__note {
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    color: var(--ink-4);
  }
  .body {
    max-width: 62rem;
    padding-top: var(--sp-roomy);
    border-top: 1px solid var(--rule);
  }
  .body p {
    font-size: var(--t-lede);
    line-height: 1.55;
    color: var(--ink-2);
  }
</style>
