---
import Girih from './Girih.astro';

/**
 * A looping clip that has a day version and a night version.
 *
 * Same bargain as ModeImage: both files are in the DOM and CSS picks, so
 * switching service does not wait on a download and there is no flash of the
 * wrong one. The difference is that a video also has to be told to play, which
 * the controller in the layout does — it starts only the clip that is actually
 * visible and actually the current service, and it does not start anything at
 * all for a reader who has asked for reduced motion.
 *
 * `preload="none"` matters here. Six panels with two clips each is twelve
 * files; fetching them all at page load would cost more than the rest of the
 * site put together, and most readers will never scroll past the third.
 *
 * With neither file present the frame falls back to an İznik tile panel, so the
 * page is complete before the footage arrives.
 */
interface Props {
  /** Path stem: /finds/mud loads -day.mp4 and -night.mp4. */
  src?: string;
  /** Poster stem, same convention. Shown before play and under reduced motion. */
  poster?: string;
  alt: string;
  caption?: string;
  ratio?: string;
  tint?: 'cobalt' | 'turquoise' | 'bole' | 'gold';
}
const { src, poster, alt, caption, ratio = '4 / 3', tint = 'turquoise' } = Astro.props;
---

<figure class="mvid" style={`--ratio:${ratio}; --tint: var(--${tint})`}>
  <div class="mvid__frame">
    {
      src ? (
        <>
          <video
            class="mvid__v mvid__v--day"
            src={`${src}-day.mp4`}
            poster={poster ? `${poster}-day.webp` : undefined}
            muted
            loop
            playsinline
            preload="none"
            aria-label={alt}
            data-mode-video="day"
          />
          <video
            class="mvid__v mvid__v--night"
            src={`${src}-night.mp4`}
            poster={poster ? `${poster}-night.webp` : undefined}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            data-mode-video="night"
          />
          {/* A moving picture in the corner of the eye reads as an advert unless
              it is obviously footage. The sprocket strip says film. */}
          <span class="mvid__sprocket" aria-hidden="true" />
        </>
      ) : (
        <div class="mvid__tile" role="img" aria-label={alt}>
          <Girih size={104} opacity={0.32} />
          <span class="mvid__glaze" />
        </div>
      )
    }
    <span class="mvid__rim" aria-hidden="true"></span>
  </div>
  {caption && <figcaption class="mvid__cap mono">{caption}</figcaption>}
</figure>

<style>
  .mvid {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-tight);
    min-width: 0;
  }
  .mvid__frame {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--r-panel);
    background: var(--ink);
    box-shadow:
      inset 0 0 0 1px var(--rule-strong),
      inset 0 0 0 7px var(--surface),
      inset 0 0 0 8px color-mix(in oklab, var(--ink) 14%, transparent);
  }
  .mvid__v {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Three rules, not one media query: an explicit day choice has to beat a dark
     operating system, and a media query on its own cannot do that. */
  .mvid__v--night {
    opacity: 0;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-service='day'])) .mvid__v--day {
      opacity: 0;
    }
    :global(:root:not([data-service='day'])) .mvid__v--night {
      opacity: 1;
    }
  }
  :global(:root[data-service='night']) .mvid__v--day {
    opacity: 0;
  }
  :global(:root[data-service='night']) .mvid__v--night {
    opacity: 1;
  }
  :global(:root[data-service='day']) .mvid__v--day {
    opacity: 1;
  }
  :global(:root[data-service='day']) .mvid__v--night {
    opacity: 0;
  }

  .mvid__sprocket {
    position: absolute;
    inset-block: 8px;
    inset-inline-start: 8px;
    width: 7px;
    background-image: repeating-linear-gradient(
      to bottom,
      color-mix(in oklab, #fff 62%, transparent) 0 5px,
      transparent 5px 13px
    );
    opacity: 0.5;
    pointer-events: none;
  }

  .mvid__tile {
    position: relative;
    width: 100%;
    height: 100%;
    color: var(--tint);
    background:
      radial-gradient(
        130% 100% at 78% 12%,
        color-mix(in oklab, var(--tint) 38%, transparent),
        transparent 68%
      ),
      color-mix(in oklab, var(--tint) 22%, var(--surface));
  }
  .mvid__glaze {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      142deg,
      color-mix(in oklab, #fff 26%, transparent) 0%,
      transparent 36%
    );
    pointer-events: none;
  }
  .mvid__rim {
    position: absolute;
    inset: 0;
    border-radius: var(--r-panel);
    box-shadow: inset 0 1px 0 color-mix(in oklab, #fff 30%, transparent);
    pointer-events: none;
  }
  .mvid__cap {
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    color: var(--ink-4);
    max-width: 46ch;
  }
</style>
