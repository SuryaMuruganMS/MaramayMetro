---
import NetworkMap from './NetworkMap.svelte';
import { translator } from '../../i18n/index.ts';
import { NETWORK } from '../../data/alignment.ts';
import { LINES, DRAWN_STATIONS, INTERCHANGES } from '../../data/network.ts';
import { href, num, type Locale } from '../../lib/locale.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tt = translator(locale);

/**
 * Everything the island can render, resolved here.
 *
 * The map is one component but two pieces of interface - the diagram and the
 * card that opens when a station is picked - and both take their strings from
 * this one list. Listing them rather than shipping the dictionary keeps the
 * page carrying only what it can actually say.
 */
const KEYS = [
  'reg.label',
  'reg.diagram',
  'reg.geographic',
  'reg.section',
  'map.stepFree',
  'map.alt',
  'map.geoCaveat',
  'map.sectionCaveat',
  'map.click',
  'map.tableToggle',
  'map.tableCaption',
  'map.station',
  'map.lines',
  'map.continent',
  'map.access',
  'map.yes',
  'map.no',
  'map.notAll',
  'map.pickPrompt',
  'map.source',
  // the station card
  'map.openStation',
  'map.close',
  'map.calls',
  'map.depth',
  'map.notOnLine',
  'map.otherSide',
  'map.hereAlready',
  'map.coords',
  'map.planFrom',
  'map.faresFrom',
  'plan.duration',
  'plan.changes',
  'plan.fare',
  'x.km',
  'x.min',
  'j.europe',
  'j.asia',
];
const labels = Object.fromEntries(KEYS.map((k) => [k, tt(k)]));

/** Counts substituted into one sentence, so the sentence can be translated. */
const note = tt('map.drawnNote')
  .replace('{all}', num(NETWORK.stations.value, locale))
  .replace('{drawn}', num(DRAWN_STATIONS, locale))
  .replace('{interchanges}', num(INTERCHANGES.length, locale));
---

<section class="section">
  <div class="shell stack stack--loose">
    <header class="stack stack--snug">
      <p class="label">{tt('nav.map')}</p>
      <h1>{tt('map.title')}</h1>
      <p class="lede">{tt('map.lede')}</p>
    </header>

    <NetworkMap client:load locale={locale} labels={labels} />

    <div class="lines">
      <h2>{tt('map.linesHeading')}</h2>
      <ul class="lines__list">
        {
          LINES.map((l) => (
            <li class="lines__row">
              <span class="roundel" style={`--line:${l.colour}`}>
                {l.name}
              </span>
              <span class="lines__meta mono">
                {num(l.stations, locale)} {tt('x.stations')}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="lines__note">
        {note}
        {' '}
        <a href={href('/renkler', locale)}>{tt('nav.colours')}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .lines {
    display: flex;
    flex-direction: column;
    gap: var(--sp-snug);
  }
  .lines__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: var(--sp-tight);
  }
  .lines__row {
    display: flex;
    align-items: center;
    gap: var(--sp-tight);
    padding: 7px 10px;
    border: 1px solid var(--rule);
    border-radius: var(--r-capsule);
    background: var(--surface);
    min-width: 0;
  }
  .lines__meta {
    font-size: var(--t-micro);
    color: var(--ink-3);
    margin-left: auto;
    white-space: nowrap;
  }
  .lines__note {
    font-size: var(--t-small);
    color: var(--ink-3);
    max-width: 74ch;
  }
</style>
