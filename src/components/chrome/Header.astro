---
import Mark from './Mark.astro';
import { translator } from '../../i18n/index.ts';
import { LOCALES, LOCALE_NAME, LOCALE_TAG, href, type Locale } from '../../lib/locale.ts';

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;
const tt = translator(locale);

const NAV = [
  { key: 'nav.journey', to: '/' },
  { key: 'nav.map', to: '/harita' },
  { key: 'nav.dig', to: '/kazi' },
  { key: 'nav.plan', to: '/sefer' },
  { key: 'nav.fares', to: '/ucret' },
  { key: 'nav.travel', to: '/yolculuk' },
  { key: 'nav.access', to: '/erisilebilirlik' },
];

const isCurrent = (to: string) => path === to || (to !== '/' && path.startsWith(to));
---

<header class="head">
  <div class="head__inner">
    <a class="head__brand" href={href('/', locale)}>
      <Mark size={30} />
      <span class="head__word">
        <b>{tt('site.name')}</b>
        <em class="mono">MARMARAY</em>
      </span>
    </a>

    <nav class="head__nav" aria-label={tt('nav.journey')}>
      {
        NAV.map((n) => (
          <a
            href={href(n.to, locale)}
            class="head__link"
            aria-current={isCurrent(n.to) ? 'page' : undefined}
          >
            {tt(n.key)}
          </a>
        ))
      }
    </nav>

    <div class="head__ctl">
      <button class="ctl" type="button" data-view-toggle aria-pressed="false">
        <span class="ctl__ico" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="13" height="13">
            <rect x="1" y="2" width="14" height="2" rx="1" fill="currentColor"></rect>
            <rect x="1" y="7" width="14" height="2" rx="1" fill="currentColor"></rect>
            <rect x="1" y="12" width="14" height="2" rx="1" fill="currentColor"></rect>
          </svg>
        </span>
        <span class="ctl__txt">{tt('ctl.planview')}</span>
      </button>

      <!-- Day / night is service hours, so the icon is a clock, not a moon. -->
      <button class="ctl" type="button" data-service-toggle aria-pressed="false">
        <span class="ctl__ico" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="13" height="13">
            <circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.6"
            ></circle>
            <path
              d="M8 4.4 V8 L10.4 9.6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path>
          </svg>
        </span>
        <span class="ctl__txt">{tt('ctl.service')}</span>
      </button>

      <!--
        Four languages in a native <details>. No JavaScript, closes on Escape,
        and every option is a real link — so it works before hydration and is
        crawlable, which a scripted menu is not.
      -->
      <details class="lang">
        <summary class="ctl ctl--lang" title={tt('ctl.langPick')}>
          <span class="ctl__ico" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="13" height="13">
              <circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.5"
              ></circle>
              <path
                d="M1.6 8h12.8M8 1.6c1.9 2 2.9 4.1 2.9 6.4S9.9 12.4 8 14.4C6.1 12.4 5.1 10.3 5.1 8S6.1 3.6 8 1.6Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"></path>
            </svg>
          </span>
          <span class="mono">{LOCALE_TAG[locale]}</span>
        </summary>
        <ul class="lang__menu">
          {
            LOCALES.map((l) => (
              <li>
                <a
                  href={href(path, l)}
                  hreflang={l}
                  lang={l}
                  dir={l === 'ar' ? 'rtl' : 'ltr'}
                  aria-current={l === locale ? 'true' : undefined}
                >
                  <span class="lang__tag mono">{LOCALE_TAG[l]}</span>
                  <span class="lang__name">{LOCALE_NAME[l]}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </div>
</header>
