---
/**
 * The mark.
 *
 * A capsule with the alignment drawn through it: level, dipping under the
 * middle, level again. It is the long-section of the crossing reduced to
 * fourteen pixels, and the two dots are the continents.
 *
 * A roundel because that is what transit identity is made of, and because every
 * other project in this portfolio has a corner radius of zero.
 */
interface Props {
  size?: number;
  title?: string;
}
const { size = 30, title } = Astro.props;
---

<svg
  class="mark"
  width={size}
  height={size}
  viewBox="0 0 40 40"
  role={title ? 'img' : 'presentation'}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
>
  <rect x="1" y="1" width="38" height="38" rx="19" fill="var(--accent)"></rect>
  <path
    d="M7 16 H13 Q16 16 17.5 22 T20 27 T22.5 22 Q24 16 27 16 H33"
    fill="none"
    stroke="var(--ink-on-pigment)"
    stroke-width="2.4"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <circle cx="7" cy="16" r="2.6" fill="var(--ink-on-pigment)"></circle>
  <circle cx="33" cy="16" r="2.6" fill="var(--ink-on-pigment)"></circle>
</svg>

<style>
  .mark {
    display: block;
    flex: none;
  }
</style>
