---
import { translator } from '../../i18n/index.ts';
import { href, type Locale } from '../../lib/locale.ts';
import { NETWORK } from '../../data/alignment.ts';
import { num } from '../../lib/locale.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tt = translator(locale);

const COLS = [
  {
    head: locale === 'tr' ? 'Ağ' : 'Network',
    links: [
      { key: 'nav.journey', to: '/' },
      { key: 'nav.map', to: '/harita' },
      { key: 'nav.plan', to: '/sefer' },
      { key: 'nav.fares', to: '/ucret' },
    ],
  },
  {
    head: locale === 'tr' ? 'Bu hat' : 'This line',
    links: [
      { key: 'nav.dig', to: '/kazi' },
      { key: 'nav.build', to: '/insaat' },
      { key: 'nav.tunel', to: '/tunel-1875' },
      { key: 'nav.colours', to: '/renkler' },
    ],
  },
  {
    head: locale === 'tr' ? 'Kurum' : 'Corporate',
    links: [
      { key: 'nav.access', to: '/erisilebilirlik' },
      { key: 'nav.data', to: '/acik-veri' },
      { key: 'x.source', to: '/kaynaklar' },
    ],
  },
];
---

<footer class="foot">
  <div class="foot__inner">
    <div class="foot__cols">
      {
        COLS.map((c) => (
          <nav class="foot__col" aria-label={c.head}>
            <p class="label">{c.head}</p>
            <ul>
              {c.links.map((l) => (
                <li>
                  <a href={href(l.to, locale)}>{tt(l.key)}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="foot__col foot__col--stat">
        <p class="label">{locale === 'tr' ? 'Ağ büyüklüğü' : 'Network size'}</p>
        <ul class="foot__stats mono">
          <li>
            <b>{NETWORK.metroLines.value}</b>
            {tt('x.lines')}
          </li>
          <li>
            <b>{NETWORK.stations.value}</b>
            {tt('x.stations')}
          </li>
          <li>
            <b>{num(NETWORK.routeKm.value, locale)}</b>
            {tt('x.km')}
          </li>
        </ul>
      </div>
    </div>

    <p class="foot__legal">
      {
        locale === 'tr'
          ? 'Continuum Studios tarafından hazırlanmış kavramsal bir tasarım çalışmasıdır. Metro İstanbul, TCDD veya İETT ile bağlantısı yoktur. Bu sitede üçüncü taraf isteği, çerez veya izleme yoktur.'
          : 'A concept design build by Continuum Studios. Not affiliated with Metro İstanbul, TCDD or İETT. This site makes no third-party requests, sets no cookies and tracks nothing.'
      }
    </p>
  </div>
</footer>
