---
import { LAYERS, HULLS, DIG_DEPTH, digCopy } from '../../data/strata.ts';
import { DIG } from '../../data/alignment.ts';
import { translator } from '../../i18n/index.ts';
import { href, num, upper, type Locale } from '../../lib/locale.ts';
import Figure from '../ui/Figure.astro';
import DigAxis from './DigAxis.svelte';
import FindsRail from './FindsRail.astro';

/**
 * The dig, read twice.
 *
 * DOWN is the strata: the one place on this site where the vertical axis is
 * time, because at Yenikapı depth and time genuinely coincide. The railway cut
 * a section through eight and a half thousand years of the city and the layers
 * are in the order the ground put them in.
 *
 * ACROSS is the finds rail below it: not what was underneath, but what was
 * carried out. A gallery is the shape of that question, and it is also how the
 * material is shown at the station today.
 *
 * Two readings of one dig, and they are tied together — every panel on the rail
 * names the layer it came out of.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tt = translator(locale);
const { layerOf, hullOf } = digCopy(locale);

const pct = (m: number) => (m / DIG_DEPTH) * 100;

/** BCE years take a locale-specific frame, so the era marker is translatable. */
const fmtYear = (y: number) =>
  y < 0 ? tt('dig.bce').replace('{n}', num(Math.abs(y), locale)) : num(y, locale);
---

<section class="dig">
  <header class="dig__head shell">
    <p class="label">{upper(tt('dig.place'), locale)}</p>
    <h1>{tt('dig.title')}</h1>
    <p class="lede">{tt('dig.lede')}</p>

    <dl class="dig__figs">
      <Figure
        locale={locale}
        k={tt('dig.k.artefacts')}
        v={`~${num(DIG.artefacts.value, locale)}`}
        source={DIG.artefacts.source}
      />
      <Figure
        locale={locale}
        k={tt('dig.k.hulls')}
        v={String(DIG.hulls.value)}
        source={DIG.hulls.source}
      />
      <Figure
        locale={locale}
        k={tt('dig.k.oldest')}
        v={fmtYear(-DIG.oldestBCE.value)}
        source={DIG.oldestBCE.source}
      />
      <Figure
        locale={locale}
        k={tt('dig.k.delay')}
        v={tt('dig.v.delay')}
        source="yenikapi-excavation"
      />
    </dl>

    <p class="dig__cue mono">
      <span class="dig__cue-arrow" aria-hidden="true">↓</span>
      {tt('dig.scrollDown')}
    </p>
  </header>

  <!-- The section itself. Scroll down and the ground gets older. -->
  <div class="dig__section" id="dig">
    <DigAxis
      client:load
      locale={locale}
      labels={{ depth: tt('dig.depthAxis'), year: tt('dig.periodAxis') }}
    />

    <ol class="strata">
      {
        LAYERS.map((l) => {
          const c = layerOf(l);
          const h = pct(l.depthM[1] - l.depthM[0]);
          return (
            <li
              class="stratum"
              data-tone={l.tone}
              data-layer={l.id}
              style={`--h:${h}`}
              aria-labelledby={`layer-${l.id}`}
            >
              <div class="stratum__rule" aria-hidden="true">
                <span class="stratum__depth mono">
                  {l.depthM[0]}–{l.depthM[1]} m
                </span>
              </div>

              <div class="stratum__body">
                <p class="stratum__period mono">{c.period}</p>
                <h2 class="stratum__name" id={`layer-${l.id}`}>
                  {c.name}
                </h2>
                <p class="stratum__text">{c.body}</p>

                {/*
                  The rest of the record, and the reason the band is not empty.

                  Every layer is sized to its real excavated depth, so the thick
                  ones ran a screen deep behind four lines of text. The space
                  now holds the three notes a section drawing always carries —
                  matrix, contents, method — beside a drawing of the section
                  itself with this band lit, so a reader who has scrolled past
                  three layers can see where they are without scrolling back.
                */}
                <div class="stratum__fill">
                  <dl class="field">
                    <div>
                      <dt class="label">{tt('dig.f.matrix')}</dt>
                      <dd>{c.matrix}</dd>
                    </div>
                    <div>
                      <dt class="label">{tt('dig.f.holds')}</dt>
                      <dd>{c.holds}</dd>
                    </div>
                    <div>
                      <dt class="label">{tt('dig.f.method')}</dt>
                      <dd>{c.method}</dd>
                    </div>
                  </dl>

                  <figure class="colsec">
                    <figcaption class="label">{tt('dig.colTitle')}</figcaption>
                    <svg
                      viewBox={`0 0 84 ${DIG_DEPTH * 10 + 4}`}
                      role="img"
                      aria-label={`${c.name}: ${l.depthM[0]}–${l.depthM[1]} m`}
                    >
                      {/* The scale, on the left, the way a section drawing has it. */}
                      {[0, 5, 10, 15, 20].map((d) => (
                        <g>
                          <line
                            class="colsec__rule"
                            x1="17.5"
                            x2="20"
                            y1={d * 10 + 2}
                            y2={d * 10 + 2}
                          />
                          <text class="colsec__tick" x="15" y={d * 10 + 2 + 2.4}>
                            {num(d, locale)}
                          </text>
                        </g>
                      ))}

                      {/* Every band, in depth order. This one lit, the rest quiet. */}
                      {LAYERS.map((o) => (
                        <rect
                          class="colsec__band"
                          data-tone={o.tone}
                          data-on={o.id === l.id ? '1' : null}
                          x="20"
                          y={o.depthM[0] * 10 + 2}
                          width="30"
                          height={(o.depthM[1] - o.depthM[0]) * 10}
                        />
                      ))}
                      <rect
                        class="colsec__on"
                        x="20"
                        y={l.depthM[0] * 10 + 2}
                        width="30"
                        height={(l.depthM[1] - l.depthM[0]) * 10}
                      />
                      <text
                        class="colsec__here"
                        x="54"
                        y={((l.depthM[0] + l.depthM[1]) / 2) * 10 + 2 + 2.6}
                      >
                        {l.depthM[0]}–{l.depthM[1]} m
                      </text>
                    </svg>
                    <p class="colsec__cap mono">
                      {tt('dig.colCap').replace('{n}', num(DIG_DEPTH, locale))}
                    </p>
                  </figure>
                </div>

                {l.id === 'byzantine' && (
                  <ul class="hulls">
                    {HULLS.map((hl) => {
                      const hc = hullOf(hl);
                      return (
                        <li class="hull">
                          <span class="hull__ref mono">{hl.ref}</span>
                          <span class="hull__type">{hc.type}</span>
                          <span class="hull__c mono">
                            {hl.century} {tt('dig.century')}
                          </span>
                          <span class="hull__note">{hc.note}</span>
                        </li>
                      );
                    })}
                    <li class="hull hull--rest mono">
                      {tt('dig.moreHulls').replace(
                        '{n}',
                        num(DIG.hulls.value - HULLS.length, locale),
                      )}
                    </li>
                  </ul>
                )}
              </div>

              {/*
                 The bottom of the trench.

                 The deepest band is also the tallest, and it ended in ground
                 with nothing under it — which is true of the excavation and
                 read as an unfinished page. Saying so closes both.
              */}
              {l.id === LAYERS[LAYERS.length - 1].id && (
                <p class="strata__floor mono">{tt('dig.floor')}</p>
              )}
            </li>
          );
        })
      }
    </ol>
  </div>

  <!-- And the same dig, sideways. -->
  <FindsRail locale={locale} />

  <!-- The honest part. A public body should say why its railway was late. -->
  <div class="dig__why shell">
    <h2>{tt('dig.why')}</h2>
    <p>{tt('dig.whyBody')}</p>
    <p class="dig__respect">{tt('dig.respect')}</p>
    <div class="dig__acts">
      <a class="tile" href={href('/', locale)}>{tt('dig.back')}</a>
      <a class="tile tile--ghost" href={href('/kaynaklar', locale)}>{tt('x.source')}</a>
    </div>
  </div>
</section>
