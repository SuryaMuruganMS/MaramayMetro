---
import Planner from './Planner.svelte';
import { MAP_KEYS } from '../map/keys.ts';
import PageHead from '../ui/PageHead.astro';
import InfoNote from '../ui/InfoNote.astro';
import { translator } from '../../i18n/index.ts';
import { href, type Locale } from '../../lib/locale.ts';
import { PASSENGERS, BANDS } from '../../data/fares.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tt = translator(locale);

/**
 * The planner is an island, so every string it can render has to be resolved
 * here and handed over. Listing them explicitly rather than shipping the whole
 * dictionary keeps the payload to what this page actually says.
 */
const KEYS = [
  'plan.from',
  'plan.to',
  'plan.swap',
  'plan.duration',
  'plan.changes',
  'plan.deepest',
  'plan.same',
  'plan.none',
  'plan.stepFreeOk',
  'plan.stepFreeNo',
  'plan.indicative',
  'plan.passenger',
  'plan.fare',
  'plan.fareNote',
  'plan.fareBreak',
  'plan.travelsFree',
  'plan.fullFare',
  'plan.firstTap',
  'plan.showMap',
  'plan.hideMap',
  'plan.fullMap',
  'fare.free',
  'fare.transfer',
  'fare.band',
  'fare.rate',
  'x.min',
  'x.km',
  ...PASSENGERS.map((p) => p.key),
  ...BANDS.map((b) => b.key),
  /* The planner mounts the map page's map, so it has to hand over the map
     page's strings. Importing the list rather than copying it is the whole
     point: the first version of this shipped a station card with no name on
     it, because the planner's own list did not know what a station card was. */
  ...MAP_KEYS,
];
const labels = Object.fromEntries(KEYS.map((k) => [k, tt(k)]));
---

<section class="section">
  <div class="shell stack stack--loose">
    <PageHead
      locale={locale}
      eyebrow={tt('nav.plan')}
      title={tt('plan.title')}
      lede={tt('plan.lede')}
    />

    <!-- The planner quotes money, so the same warning that guards the fares
         table guards this one, in the same shape, immediately above it.

         A div, not a p: <details> is flow content and the parser closes an open
         paragraph at its start tag, which dropped the note onto its own line
         with the text stranded below it. -->
    <div class="pricewarn">
      <InfoNote
        label={tt('fare.info')}
        title={tt('fare.fictional')}
        body={tt('fare.fictionalBody')}
        linkHref="https://www.metro.istanbul/"
        linkText={tt('disclosure.link')}
      />
      <span
        >{tt('fare.fictional')} — <a href={href('/ucret', locale)}>{tt('fare.title')}</a></span
      >
    </div>

    <Planner client:load locale={locale} labels={labels} />

    <!-- Without scripting the planner cannot run, so say what to do instead
         rather than rendering an inert set of dropdowns. -->
    <noscript>
      <p class="card">
        {tt('plan.noJs')}
        <a href={href('/harita', locale)}>{tt('map.title')}</a>
      </p>
    </noscript>
  </div>
</section>

<style>
  .pricewarn {
    display: flex;
    align-items: center;
    gap: var(--sp-tight);
    margin: 0;
    font-size: var(--t-small);
    color: var(--ink-3);
  }
  @media (max-width: 560px) {
    /* The note goes block at this width so its panel can take flow space. */
    .pricewarn {
      display: block;
    }
  }
</style>
