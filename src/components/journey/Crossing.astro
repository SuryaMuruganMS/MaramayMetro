---
import Track from './Track.astro';
import SectionRail from './SectionRail.astro';
import Engine from './Engine.svelte';
import Girih from '../ui/Girih.astro';
import ModeImage from '../ui/ModeImage.astro';
import { modeAsset } from '../../lib/assets.ts';
import Figure from '../ui/Figure.astro';
import { journeyCopy } from '../../data/journey-copy.ts';
import { translator } from '../../i18n/index.ts';
import { CORRIDOR, NETWORK } from '../../data/alignment.ts';
import type { Locale } from '../../lib/locale.ts';

/**
 * The whole landing experience, in one component both locales mount.
 *
 * It exists because the first version of this was two page files with the copy
 * inlined as ternaries on the locale, and the English one was generated by
 * find-and-replacing the Turkish one. TypeScript flagged every ternary as
 * unreachable, which was the compiler noticing the duplication before a human
 * did. Strings live in the dictionary; the structure lives here, once.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tt = translator(locale);
const copy = journeyCopy(locale);

const labels = {
  chainage: tt('ro.chainage'),
  level: tt('ro.level'),
  grade: tt('ro.grade'),
  element: tt('ro.element'),
  overhead: tt('ro.overhead'),
  car: tt('ro.car'),
  // The formation names, keyed exactly as FORMATION refers to them, so the
  // car bar can look one up without a second mapping to keep in sync.
  'car.cab': tt('car.cab'),
  'car.doors': tt('car.doors'),
  'car.saloon': tt('car.saloon'),
  'car.saloon2': tt('car.saloon2'),
  'car.gangway': tt('car.gangway'),
  'car.bogie': tt('car.bogie'),
  'car.pantograph': tt('car.pantograph'),
};
---

<section class="open">
  <Girih size={150} />
  <div class="open__inner shell">
    <div class="open__cols">
      <div class="open__text">
        <p class="label">{tt('site.full')}</p>
        <h1 class="open__head">{copy.intro.head}</h1>
        <p class="lede open__lede">{copy.intro.lede}</p>

        <dl class="open__figs">
          <Figure
            locale={locale}
            k={tt('open.tunnel')}
            v={`${CORRIDOR.tunnelKm.value} km`}
            source={CORRIDOR.tunnelKm.source}
          />
          <Figure
            locale={locale}
            k={tt('open.deepest')}
            v="−60 m"
            source={CORRIDOR.deepestM.source}
          />
          <Figure
            locale={locale}
            k={tt('open.immersed')}
            v={`${CORRIDOR.immersedM.value} m`}
            source={CORRIDOR.immersedM.source}
          />
          <Figure
            locale={locale}
            k={tt('open.network')}
            v={`${NETWORK.stations.value} ${tt('x.stations')}`}
            source={NETWORK.stations.source}
          />
        </dl>

        <p class="open__hint mono">
          <span class="open__arrow" aria-hidden="true">↓</span>
          {copy.intro.scroll}
        </p>
        <p class="open__hint open__hint--sub mono">{copy.intro.both}</p>
      </div>

      <ModeImage
        src={modeAsset('/img/hero')}
        alt={tt('site.tagline')}
        ratio="4 / 5"
        tint="turquoise"
        eager={true}
      />
    </div>
  </div>
</section>

<Track locale={locale} />

<SectionRail locale={locale} />
<Engine client:load labels={labels} />

<style>
  .open {
    position: relative;
    overflow: hidden;
    /*
      The opening owns the first screen, exactly.

      Too tall and its own "scroll down" hint ends up behind the fixed rail.
      Too short - which is what tightening the padding produced - and the top of
      the first station panel appears at rest, half of it under the rail. A
      min-height tied to the viewport pins it: the chrome above (disclosure and
      header) and the rail below come off, and the opening takes what is left.
    */
    min-height: calc(100dvh - var(--head-h) - var(--rail-h) - 46px);
    display: flex;
    align-items: center;
    padding-block: var(--sp-loose) var(--sp-base);
    border-bottom: 1px solid var(--rule);
  }
  /* Two columns above the fold: the argument on the left, a still on the
     right. This is the only part of the landing page that does not travel
     sideways, so it is the only place a photograph makes sense. */
  .open__cols {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: var(--sp-loose);
    align-items: center;
    width: 100%;
  }
  .open__text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-base);
    min-width: 0;
  }
  @media (max-width: 1100px) {
    .open__cols {
      grid-template-columns: minmax(0, 1fr);
    }
    .open__cols :global(.mimg) {
      display: none;
    }
  }

  .open__inner {
    position: relative;
    width: min(100% - var(--margin) * 2, var(--shell));
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--sp-base);
  }
  .open__head {
    font-size: var(--t-mega);
    line-height: 0.9;
    letter-spacing: -0.04em;
    white-space: pre-line;
    max-width: 15ch;
  }
  /* Laptop-height screens. The opening has to fit above the rail at rest, and
     display type scaled only on width will not do that on a 800px-tall screen.
     Height is the constraint here, so height is what the query asks about. */
  @media (max-height: 900px) {
    .open {
      padding-block: var(--sp-base);
    }
    .open__inner {
      gap: var(--sp-snug);
    }
    .open__head {
      font-size: clamp(2.2rem, 7vw, 4.6rem);
    }
    .open__figs {
      margin-top: 0;
      padding-top: var(--sp-snug);
      gap: var(--sp-snug);
    }
    .open__hint {
      margin-top: 2px;
    }
  }
  .open__lede {
    max-width: 54ch;
  }
  .open__figs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(158px, 1fr));
    gap: var(--sp-base);
    margin: var(--sp-snug) 0 0;
    padding-top: var(--sp-base);
    border-top: 1px solid var(--rule);
    max-width: 62rem;
  }
  .open__hint {
    display: flex;
    align-items: center;
    gap: var(--sp-tight);
    font-size: var(--t-micro);
    letter-spacing: 0.12em;
    color: var(--ink-3);
    margin-top: var(--sp-snug);
  }
  .open__hint--sub {
    margin-top: -8px;
    color: var(--ink-4);
    padding-left: 22px;
  }
  .open__arrow {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: var(--r-capsule);
    background: var(--accent);
    color: #fff;
    font-size: 12px;
    animation: nudge 2.6s var(--ease-out) infinite;
  }
  @keyframes nudge {
    0%,
    62%,
    100% {
      transform: translateY(0);
    }
    76% {
      transform: translateY(3px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .open__arrow {
      animation: none;
    }
  }
</style>
