---
/**
 * The film band: a long train video running the length of the crossing.
 *
 * WHY IT LOOPS RATHER THAN SCRUBS
 * Scrubbing a video by scroll position is the obvious idea and it does not
 * survive contact with real browsers: frame-accurate reverse seeking is still
 * broken across codecs, so scrolling back stutters or freezes on a keyframe.
 * The video plays at its own speed as atmosphere; everything that has to be
 * exact — chainage, depth, which car you are in — is derived from the scroll
 * position and drawn on top. Nobody can tell the difference, and nothing
 * stutters.
 *
 * TWO FILMS, ONE BAND
 * Day service runs the underwater crossing; night service runs the tunnel.
 * Both are in the DOM and CSS picks, so switching service does not wait on a
 * download and there is no flash of the wrong one.
 *
 * WHEN NEITHER FILE EXISTS
 * The band falls back to a drawn gradient and the site is complete without it.
 * A missing video should not leave a black rectangle where the journey was.
 */
interface Props {
  /** Clip per mode, from `filmAsset`. Either may be missing. */
  film?: { day?: string; night?: string };
  /** Poster still per mode, from `posterAsset`. Stands in for a missing clip. */
  poster?: { day?: string; night?: string };
}
const { film = {}, poster = {} } = Astro.props;

/**
 * What to paint for each mode: the clip if there is one, else its poster.
 *
 * The night cut of the crossing exists and the day cut does not yet. Refusing
 * to show either until the pair is complete would hide finished work; showing
 * the night film in day service would be a straightforward lie about what the
 * switch does. So day service gets the day poster — the same shot, held still —
 * and starts moving the day the film lands.
 */
const MODES = (['day', 'night'] as const).map((m) => ({
  m,
  video: film[m],
  still: film[m] ? undefined : poster[m],
}));
const anything = MODES.some((x) => x.video || x.still);
---

<div class="film" aria-hidden="true">
  <div class="film__edge film__edge--top"></div>

  <div class="film__stage">
    {
      anything ? (
        MODES.map((x) =>
          x.video ? (
            <video
              class={`film__v film__v--${x.m}`}
              src={x.video}
              poster={poster[x.m]}
              muted
              loop
              playsinline
              preload="none"
              data-mode-video={x.m}
              data-motion-gated
            />
          ) : x.still ? (
            <img class={`film__v film__v--${x.m}`} src={x.still} alt="" loading="lazy" />
          ) : (
            <div class={`film__v film__v--${x.m} film__drawn`} />
          ),
        )
      ) : (
        <div class="film__drawn" />
      )
    }
    <div class="film__wash"></div>
  </div>

  <div class="film__edge film__edge--bottom"></div>
</div>

<style>
  .film {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }

  /*
    The borders.

    Solid bands of the page's own ground, not a fade — so the video reads as a
    window cut into the page rather than an image bleeding off it. They also do
    real work: the top band clears the fixed header and the bottom one clears
    the section rail, which is why they are sized from those tokens rather than
    from a round number.
  */
  .film__edge {
    flex: none;
    background: var(--ground);
    transition: background-color 180ms linear;
  }
  .film__edge--top {
    height: calc(var(--chrome-h) + var(--sp-tight));
    box-shadow: 0 1px 0 var(--rule);
  }
  .film__edge--bottom {
    height: calc(var(--rail-h) + var(--sp-tight));
    box-shadow: 0 -1px 0 var(--rule);
  }

  .film__stage {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    background: var(--band-abyssal);
  }
  /*
    Wider than its stage, on purpose: the right edge is cropped off.

    Both clips carry the generator's sparkle watermark burned into the frames,
    centred at about 91% across and 84% down. There is no way to take it out of
    the pixels here, so the frame is cropped instead: the element is 116% of the
    stage and pinned to the left, which puts everything past 86% of the picture
    outside the stage's `overflow: hidden`. The watermark lands at 91% × 116% =
    106% of the stage and is never painted.

    No transform is used to do it. A transform's overflow counts toward the
    document's scrollable width — that is what the glow's `scale(1.15)` cost on
    /insaat/ — where an absolutely positioned box inside a clipping parent
    costs nothing. The visible price is a 16% zoom on a background film, which
    is invisible, and the loss of the right-hand seventh of a shot that was
    composed centre-left anyway.
  */
  .film__v {
    position: absolute;
    top: 0;
    left: 0;
    width: 116%;
    /* base.css caps every img/svg/video at `max-width: 100%`, which silently
       clamped the 116% straight back to the stage width and left the watermark
       exactly where it was. */
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: 42% 50%;
  }

  /* Day is default; night takes over by either route. Three rules, so an
     explicit day choice beats a dark operating system. */
  .film__v--night {
    opacity: 0;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-service='day'])) .film__v--day {
      opacity: 0;
    }
    :global(:root:not([data-service='day'])) .film__v--night {
      opacity: 1;
    }
  }
  :global(:root[data-service='night']) .film__v--day {
    opacity: 0;
  }
  :global(:root[data-service='night']) .film__v--night {
    opacity: 1;
  }
  :global(:root[data-service='day']) .film__v--day {
    opacity: 1;
  }
  :global(:root[data-service='day']) .film__v--night {
    opacity: 0;
  }

  /* Drawn stand-in: the water column by day, the bore by night. */
  .film__drawn {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        120% 80% at 50% 0%,
        color-mix(in oklab, var(--turquoise) 34%, transparent),
        transparent 70%
      ),
      linear-gradient(180deg, var(--band-deep), var(--band-abyssal));
  }

  /*
    The wash.

    A brightness correction, not a veil. Panel text sits over this band, and a
    video's exposure is not ours to rely on — so the stage is pulled toward the
    page's own ground far enough that ink keeps its contrast ratio, and no
    further. Masked so it is heaviest where the text is and lightest at the
    right, where the reader is looking ahead into the tunnel.
  */
  .film__wash {
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--ground) var(--wash), transparent);
    backdrop-filter: saturate(1.1);
    mask-image: linear-gradient(
      100deg,
      #000 0%,
      #000 46%,
      color-mix(in oklab, #000 55%, transparent) 78%,
      color-mix(in oklab, #000 35%, transparent) 100%
    );
  }

  /*
     How much wash, and why it depends on the service.

     The wash exists to keep panel copy readable over moving footage, and 62%
     is right over a bright daylight shot. Over the night cut it was a disaster:
     the ground colour in night service is nearly black, the tunnel footage is
     nearly black, and 62% of one over the other left the band looking like a
     plain dark rectangle. The film was playing perfectly and could not be seen.

     Night gets 34%, which is still enough to hold the text — the copy is set in
     near-white on a tunnel wall — and leaves the train visible, which is the
     entire point of having filmed one.
  */
  .film__stage {
    --wash: 62%;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-service='day'])) .film__stage {
      --wash: 34%;
    }
  }
  :global(:root[data-service='night']) .film__stage {
    --wash: 34%;
  }
  :global(:root[data-service='day']) .film__stage {
    --wash: 62%;
  }

  @media (prefers-reduced-motion: reduce) {
    .film__v {
      display: none;
    }
  }
</style>
