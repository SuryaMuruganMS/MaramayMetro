---
import { modeAsset } from '../../lib/assets.ts';

/**
 * The photograph behind the opening, full bleed.
 *
 * The technique is measured off okaydev.co, whose hero does the same thing:
 * an absolutely-positioned `object-fit: cover` image at partial opacity with a
 * blend mode, so the photograph takes the page's colour instead of sitting on
 * top of it. Paste a photograph over a palette and you have two designs; blend
 * it in and you have one.
 *
 * WHY TWO SCRIMS AND NOT ONE
 * A single flat overlay dark enough to hold the headline also kills the
 * picture. So the darkening is directional: heavy on the side the text starts
 * from, almost nothing on the far side, plus a short one at the foot where the
 * section rail sits. The reader gets a legible headline AND a photograph,
 * which one overlay cannot give you.
 *
 * WHICH FILE
 * `/img/backdrop-*` if it exists, otherwise `/img/hero-*`. The hero pair was
 * composed as an inset panel — subject on the right, portrait-ish — and it
 * works here, but a picture made for full bleed wants a different frame. This
 * way the page is right today and better the day the backdrop pair lands, with
 * no broken window in between.
 */
const src = modeAsset('/img/backdrop') ?? modeAsset('/img/hero');
---

{
  src && (
    <div class="bd" aria-hidden="true">
      <img class="bd__i bd__i--day" src={`${src}-day.webp`} alt="" fetchpriority="high" />
      <img class="bd__i bd__i--night" src={`${src}-night.webp`} alt="" fetchpriority="high" />
      <div class="bd__scrim" />
      <div class="bd__foot" />
    </div>
  )
}

<style>
  .bd {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .bd__i {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% 50%;
    /*
      Blended, not laid on.

      `luminosity` keeps the photograph's light and shadow and throws away its
      colour, so what tints it is the ground underneath — which is the depth
      band, which changes as the reader descends. The picture belongs to the
      palette rather than arguing with it.
    */
    mix-blend-mode: luminosity;
    /*
       Day sits much higher than night, and that is not an oversight.
       Luminosity blending throws the photograph's colour away and takes the
       ground's; on a near-white day ground that leaves a pale image with very
       little left in it, where the same treatment on a near-black night ground
       keeps plenty. Matching the two numbers matches the maths, not the
       picture. 0.5 was invisible in daylight.
    */
    opacity: 0.82;
  }

  /* The pair, resolved exactly the way ModeImage resolves it: three rules, so
     an explicit day choice beats a dark operating system. */
  .bd__i--night {
    opacity: 0;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-service='day'])) .bd__i--day {
      opacity: 0;
    }
    :global(:root:not([data-service='day'])) .bd__i--night {
      opacity: 0.62;
    }
  }
  :global(:root[data-service='night']) .bd__i--day {
    opacity: 0;
  }
  :global(:root[data-service='night']) .bd__i--night {
    opacity: 0.62;
  }
  :global(:root[data-service='day']) .bd__i--day {
    opacity: 0.82;
  }
  :global(:root[data-service='day']) .bd__i--night {
    opacity: 0;
  }

  /* Directional, so the headline side is dark and the picture side is not. */
  .bd__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      var(--ground) 0%,
      color-mix(in oklab, var(--ground) 86%, transparent) 32%,
      color-mix(in oklab, var(--ground) 32%, transparent) 58%,
      transparent 100%
    );
  }
  /* And a short one at the foot, where the section rail crosses the picture. */
  .bd__foot {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 34%;
    background: linear-gradient(to top, var(--ground) 0%, transparent 100%);
  }

  /*
    A slow drift as the opening leaves.

    Scroll-driven, so it is the reader's own scrolling doing it and it runs
    backwards when they scroll back. The move is small on purpose: this is the
    ground the headline is set on, and ground that slides about is a distraction
    rather than an effect.
  */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .bd__i {
        animation: bd-drift linear both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }
    }
  }
  @keyframes bd-drift {
    from {
      transform: scale(1.06) translate3d(0, -1.2%, 0);
    }
    to {
      transform: scale(1.06) translate3d(0, 2.4%, 0);
    }
  }

  /* Below the two-column breakpoint the headline runs the full width, so the
     picture has to step back further or the type sits on top of a building. */
  @media (max-width: 1100px) {
    .bd__i {
      opacity: 0.42;
      object-position: 60% 50%;
    }
    :global(:root[data-service='night']) .bd__i--night,
    :global(:root:not([data-service='day'])) .bd__i--night {
      opacity: 0.4;
    }
    :global(:root[data-service='day']) .bd__i--day {
      opacity: 0.42;
    }
    .bd__scrim {
      background: linear-gradient(
        to bottom,
        color-mix(in oklab, var(--ground) 82%, transparent) 0%,
        color-mix(in oklab, var(--ground) 62%, transparent) 100%
      );
    }
  }
</style>
