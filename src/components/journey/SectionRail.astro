---
import {
  CH_END,
  DIVIDE_CH,
  IMMERSED_END,
  IMMERSED_START,
  PROFILE,
  STOPS,
  STRAIT,
} from '../../data/alignment.ts';
import { translator } from '../../i18n/index.ts';
import type { Locale } from '../../lib/locale.ts';

/**
 * The second scrollbar.
 *
 * This is a real overflow-x container, so the browser draws a real horizontal
 * scrollbar underneath it - draggable, clickable, arrow-key operable, and
 * page-able with shift+wheel. What it contains is the long-section of the
 * tunnel, which means dragging that scrollbar is dragging the train along the
 * line.
 *
 * That is the site's signature interaction, and it only works because nothing
 * here is a simulation. A div styled to look like a scrollbar would have to
 * reimplement every one of those behaviours, and would get most of them wrong.
 *
 * Drawn from the same PROFILE array the engine reads, so the picture and the
 * numbers cannot disagree.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tt = translator(locale);

const W = 1400;
const H = 61;
const TOP_E = 12;
const BOT_E = -66;

const x = (ch: number) => (ch / CH_END) * W;
const y = (e: number) => 4 + ((TOP_E - e) / (TOP_E - BOT_E)) * (H - 10);

const line = PROFILE.map((p) => `${x(p.ch).toFixed(1)},${y(p.level).toFixed(1)}`).join(' ');

const seaY = y(0);
// Indicative bathymetry, matching the engine's own model of the strait.
const seabed: string[] = [];
for (let i = 0; i <= 24; i++) {
  const ch = STRAIT.from + ((STRAIT.to - STRAIT.from) * i) / 24;
  const dip = Math.sin(Math.PI * (i / 24));
  const lvl = -12 + (STRAIT.seabedLevel + 12) * dip;
  seabed.push(`${x(ch).toFixed(1)},${y(lvl).toFixed(1)}`);
}

const tickEvery = 1000;
const ticks: number[] = [];
for (let ch = 0; ch <= CH_END; ch += tickEvery) ticks.push(ch);
---

<div
  class="rail"
  id="rail"
  role="scrollbar"
  aria-controls="journey"
  aria-orientation="horizontal"
  aria-label={locale === 'tr'
    ? 'Hat boyunca konum — sürükleyerek ilerleyin'
    : 'Position along the line — drag to travel'}
  tabindex="0"
>
  <div class="rail__inner" style={`--divide-pct:${((DIVIDE_CH / CH_END) * 100).toFixed(2)}%`}>
    <svg class="rail__svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
      <!-- the water column over the strait -->
      <path
        d={`M${x(STRAIT.from)},${seaY} L${x(STRAIT.to)},${seaY} L${seabed
          .slice()
          .reverse()
          .join(' L')} Z`}
        fill="var(--turquoise)"
        opacity="0.22"></path>
      <line
        x1={x(STRAIT.from)}
        y1={seaY}
        x2={x(STRAIT.to)}
        y2={seaY}
        stroke="var(--turquoise)"
        stroke-width="1.5"></line>

      <!-- the ground below, so the tunnel reads as being inside something -->
      <polyline points={seabed.join(' ')} fill="none" stroke="var(--rule-strong)" stroke-width="1"
      ></polyline>

      <!-- chainage ticks, every kilometre -->
      {
        ticks.map((ch) => (
          <line
            x1={x(ch)}
            y1={H - 5}
            x2={x(ch)}
            y2={H - 1}
            stroke="var(--ink-4)"
            stroke-width="1"
          />
        ))
      }

      <!-- the immersed tube, drawn heavier because it is a different object -->
      <line
        x1={x(IMMERSED_START)}
        y1={y(-52)}
        x2={x(IMMERSED_END)}
        y2={y(-52)}
        stroke="var(--gold)"
        stroke-width="4"
        stroke-linecap="round"
        opacity="0.75"></line>

      <!-- the continental divide -->
      <line
        x1={x(DIVIDE_CH)}
        y1="2"
        x2={x(DIVIDE_CH)}
        y2={H - 6}
        stroke="var(--accent)"
        stroke-width="1"
        stroke-dasharray="3 3"
        opacity="0.7"></line>

      <!-- the alignment -->
      <polyline
        points={line}
        fill="none"
        stroke="var(--accent)"
        stroke-width="2.4"
        stroke-linejoin="round"
        stroke-linecap="round"></polyline>

      <!--
        Stations, and every one of them is a control.

        The rail was already a real scrollbar you could drag; these make it a
        set of destinations you can press. The circle is 3.6 units in a
        preserveAspectRatio="none" viewBox, which is a smear a few pixels wide
        on screen — so the thing that takes the press is the invisible bar
        drawn behind it, full height and generous, and the circle is only what
        you see.
      -->
      {
        STOPS.map((s) => (
          <g class="rail__pin" data-ch={s.ch}>
            <title>{s.name}</title>
            <rect
              class="rail__hit"
              x={x(s.ch) - 9}
              y="0"
              width="18"
              height={H}
              fill="transparent"
            />
            <circle
              class="rail__dot"
              cx={x(s.ch)}
              cy={y(s.level)}
              r="3.6"
              fill="var(--surface)"
              stroke="var(--accent)"
              stroke-width="2"
            />
          </g>
        ))
      }
    </svg>

    <!--
      Continent labels as HTML, not SVG text.

      The rail's viewBox is stretched with preserveAspectRatio="none" so the
      long-section fills the width whatever the screen. That distortion applies
      to glyphs too, and the labels came out smeared horizontally across the
      water. HTML positioned by percentage sits in the same place and is not
      scaled at all.
    -->
    <span class="rail__side rail__side--eu" aria-hidden="true">{tt('j.europe')}</span>
    <span class="rail__side rail__side--as" aria-hidden="true">{tt('j.asia')}</span>

    <span class="rail__window" id="rail-window" aria-hidden="true"></span>

    <!--
      The stations again, as real links. The SVG is decoration for sighted
      readers; this is how the rail is used with a keyboard or a screen reader,
      and how a station is reached without dragging anything.
    -->
    <ul class="rail__stops">
      {
        STOPS.map((s) => (
          <li style={`left:${(s.ch / CH_END) * 100}%`}>
            <a href={`?ch=${s.ch}`} class="rail__stop" data-ch={s.ch} title={s.name}>
              <span class="visually-hidden">{s.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  /**
   * A station on the rail takes you to it.
   *
   * The links already worked — they are `?ch=…` and the engine restores a deep
   * link before the first frame — but they worked by reloading the whole page
   * to travel four hundred metres. This intercepts them and hands the chainage
   * to the engine instead, which owns the only correct mapping from a position
   * on the line to a position in the document.
   *
   * The SVG dots get the same treatment, and they are keyboard-reachable in
   * their own right, so a reader who can see the section can press the station
   * they can see rather than hunting for its invisible twin in the list.
   */
  function goto(ch: number, replace: boolean) {
    window.dispatchEvent(new CustomEvent('crossing:goto', { detail: { ch } }));
    // Keep the address bar honest, without a history entry per station.
    const url = new URL(location.href);
    url.searchParams.set('ch', String(Math.round(ch)));
    history[replace ? 'replaceState' : 'pushState']({}, '', url);
  }

  document.querySelectorAll<HTMLElement>('[data-ch]').forEach((el) => {
    const ch = Number(el.dataset.ch);
    if (!Number.isFinite(ch)) return;
    if (el.tagName === 'G') {
      el.setAttribute('tabindex', '0');
      el.setAttribute('role', 'button');
    }
    el.addEventListener('click', (e) => {
      e.preventDefault();
      goto(ch, false);
    });
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        goto(ch, false);
      }
    });
  });
</script>

<style>
  .rail__side {
    position: absolute;
    top: 3px;
    font-family: var(--f-mono);
    font-size: 8px;
    letter-spacing: 0.22em;
    color: var(--ink-4);
    pointer-events: none;
    white-space: nowrap;
  }
  .rail__side--eu {
    right: calc(100% - var(--divide-pct) + 0.6%);
  }
  .rail__side--as {
    left: calc(var(--divide-pct) + 0.6%);
  }
  :global(:root[data-continent='EU']) .rail__side--eu,
  :global(:root[data-continent='AS']) .rail__side--as {
    color: var(--accent);
  }

  .rail__stops {
    position: absolute;
    inset: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rail__stops li {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
  }
  .rail__stop {
    position: absolute;
    top: 50%;
    left: 0;
    translate: -50% -50%;
    width: 26px;
    height: 26px;
    border-radius: var(--r-capsule);
  }
  .rail__stop:hover {
    background: color-mix(in oklab, var(--accent) 22%, transparent);
  }

  @media (max-width: 1023px) {
  
  /* A station on the rail is a button. It says so on hover and under a
     keyboard, and it grows rather than changing colour, because at this size a
     colour change is invisible and a size change is not. */
  .rail__pin {
    cursor: pointer;
  }
  .rail__dot {
    transition:
      r var(--d-hover) var(--ease-out),
      stroke-width var(--d-hover) var(--ease-out);
  }
  .rail__pin:hover .rail__dot,
  .rail__pin:focus-visible .rail__dot {
    r: 5.4;
    stroke-width: 3;
  }
  .rail__pin:focus-visible {
    outline: none;
  }
  .rail__pin:focus-visible .rail__hit {
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-dasharray: 3 3;
  }
</style>
